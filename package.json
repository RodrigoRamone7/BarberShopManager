{
  "name": "barbershop-manager",
  "version": "1.0.0",
  "description": "Sistema de gerenciamento de ordens de serviço e comissões para barbearia",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test src/testes/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "barbearia",
    "comissoes",
    "ordem-de-servico",
    "typescript"
  ],
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
