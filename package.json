{
  "name": "barbershop-manager",
  "version": "1.0.0",
  "description": "Sistema de gerenciamento de ordens de serviço e comissões para barbearia",
  "main": "dist/index.js",
  "scripts": {
    "build:web": "vite build",
    "build": "npm run build:web && tsc",
    "dev": "npm run build:web && tsx watch src/index.ts",
    "dev:web": "vite",
    "start": "node dist/index.js",
    "test": "tsx --test src/testes/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.frontend.json --noEmit"
  },
  "keywords": [
    "barbearia",
    "comissoes",
    "ordem-de-servico",
    "typescript"
  ],
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "express": "^5.3.0",
    "multicast-dns": "^7.2.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
